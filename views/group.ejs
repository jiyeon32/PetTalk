<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>지역모임</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/common.css">
  <link rel="stylesheet" href="css/group.css">
</head>

<body>
  <!-- 공통 헤더 포함 -->
  <%- include('header') %>

  <div class="group-header my-4">
    <h2 class="text-center">지역 그룹 모임</h2>
  </div>

  <!-- 그룹 생성 버튼 -->
  <div class="container my-4">
    <button id="showGroupFormBtn" class="btn btn-primary">그룹 생성</button>
  </div>

  <!-- 그룹 생성 폼 (기본적으로 숨김) -->
  <div id="groupForm" class="container my-4" style="display: none;">
    <h4>그룹 생성</h4>
    <form action="/group" method="POST" class="row g-3">
      <div class="col-md-4">
        <label for="groupName" class="form-label">그룹 이름</label>
        <input type="text" class="form-control" id="groupName" name="name" placeholder="그룹 이름을 입력하세요" required>
      </div>
      <div class="col-md-4">
        <label for="groupRegion" class="form-label">지역</label>
        <input type="text" class="form-control" id="groupRegion" name="region" placeholder="지역을 입력하세요" required>
      </div>
      <div class="col-md-12">
        <label for="groupDescription" class="form-label">그룹 설명</label>
        <textarea class="form-control" id="groupDescription" name="description" rows="3" placeholder="그룹에 대한 설명을 입력하세요" required></textarea>
      </div>
      <div class="col-md-12">
        <button type="submit" class="btn btn-primary">등록</button>
      </div>
    </form>
  </div>

  <!-- 그룹 목록 -->
  <div class="container my-4">
    <h4>모든 그룹</h4>
    <ul class="list-group">
      <% if (groups && groups.length > 0) { %>
        <% groups.forEach((group, index) => { %>
          <li class="list-group-item">
            <strong><%= group.name %></strong> (<%= group.region %>)<br>
            <%= group.description %>
          </li>
        <% }); %>
      <% } else { %>
        <li class="list-group-item text-center text-muted">등록된 그룹이 없습니다.</li>
      <% } %>
    </ul>
  </div>

  <script>
    // "그룹 생성" 버튼 클릭 시 폼 표시/숨기기
    document.getElementById('showGroupFormBtn').addEventListener('click', function () {
      const form = document.getElementById('groupForm');
      form.style.display = form.style.display === 'none' ? 'block' : 'none';
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
