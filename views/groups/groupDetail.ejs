<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= group.name %> 상세 정보</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/common.css">
</head>

<body>
  <!-- 공통 헤더 -->
  <%- include('../header') %>

  <div class="container my-4">
    <h2 class="text-center"><%= group.name %></h2>
    <p class="text-muted text-center">지역: <%= group.region %></p>

    <!-- 그룹 소개 -->
    <div class="my-4">
      <h4>그룹 소개</h4>
      <p><%= group.description %></p>
    </div>

    <!-- 참가자 리스트 -->
    <div class="my-4">
      <h4>참가자 리스트</h4>
      <ul class="list-group">
        <% if (group.members.length > 0) { %>
          <% group.members.forEach(member => { %>
            <li class="list-group-item">
              <%= member.userId.nickname || '알 수 없는 사용자' %>
            </li>
          <% }); %>
        <% } else { %>
          <li class="list-group-item text-muted">참가자가 없습니다.</li>
        <% } %>
      </ul>
    </div>

    <!-- 모임 일정 -->
    <div class="my-4">
      <h4>모임 일정</h4>
      <p class="text-muted">모임 일정은 추후 업데이트 예정입니다.</p>
    </div>

    <!-- 가입 신청 버튼 -->
    <div class="text-center">
      <form action="/group/<%= group._id %>/join" method="POST">
        <button type="submit" class="btn btn-primary">그룹 가입 신청</button>
      </form>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
