<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>마이페이지</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/mypage.css">
  <link rel="stylesheet" href="css/common.css">
</head>
<body>

<!-- 공통 헤더 포함 -->
<%- include('../header') %>

  <!-- 개인정보 수정 카드 -->
  <div class="container mt-5">
    <div class="card shadow">
      <div class="card-header text-white">
        <h4 class="card-title mb-0">개인정보 수정</h4>
      </div>
      <div class="card-body">
        <form action="/mypage/profile" method="POST">
          <div class="mb-3">
            <label for="inputPassword" class="form-label">비밀번호</label>
            <input type="password" id="inputPassword" name="password" class="form-control" placeholder="비밀번호 입력" required>
            <small class="form-text text-muted">영문 대소문자/숫자/특수문자 조합 8~16자</small>
          </div>
          <div class="mb-3">
            <label for="inputPasswordConfirm" class="form-label">비밀번호 확인</label>
            <input type="password" id="inputPasswordConfirm" name="passwordConfirm" class="form-control" placeholder="비밀번호 확인" required>
          </div>
          <div class="mb-3">
            <label for="inputNickname" class="form-label">닉네임</label>
            <input type="text" id="inputNickname" name="nickname" class="form-control" placeholder="닉네임 입력" value="<%= nickname %>" required>
            <small class="form-text text-muted">한글/영문/숫자 1~16자</small>
          </div>
          <div class="text-end">
            <button type="submit" class="btn btn-success">수정하기</button>
            <button type="reset" class="btn btn-secondary">초기화</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    document.querySelector('form').addEventListener('submit', function (e) {
      const password = document.getElementById('inputPassword').value;
      const confirmPassword = document.getElementById('inputPasswordConfirm').value;
      if (password !== confirmPassword) {
        e.preventDefault(); // 제출 중단
        alert('비밀번호가 일치하지 않습니다.');
      }
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
