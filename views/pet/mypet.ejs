<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>반려동물 관리</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/common.css">
  <link rel="stylesheet" href="css/mypet.css">
</head>
<body>

<!-- 공통 헤더 포함 -->
<%- include('../header') %>
  
  <header class="text-center my-4">
    <h2>반려동물 관리</h2>
  </header>

  <!-- 반려동물 정보 -->
  <div class="container">
    <% if (pets && pets.length > 0) { %>
      <div id="pet-info">
        <% pets.forEach(pet => { %>
          <div class="card mb-4">
            <% if (pet.photo) { %>
              <img src="<%= pet.photo %>" class="card-img-top" alt="<%= pet.name %> 사진">
            <% } else { %>
              <div class="card-img-top bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">사진 없음</div>
            <% } %>
            <div class="card-body">
              <h5 class="card-title text-center"><%= pet.name %></h5>
              <p class="card-text">성별: <%= pet.gender === 'Male' ? '남' : '여' %></p>
              <p class="card-text">몸무게: 
                <% if (pet.weight && pet.weight.length > 0) { %>
                  <%= pet.weight[pet.weight.length - 1].value %> kg
                <% } else { %>
                  정보 없음
                <% } %>
              </p>
              <p class="card-text">질환: <%= pet.diseases || '없음' %></p>
              <p class="card-text">나이: <%= pet.age || '정보 없음' %> 세</p>
              <div class="button-group">
                <button class="btn btn-primary btn-sm" onclick="editPet()">수정</button>
                <form action="/mypet/<%= pet._id %>?_method=DELETE" method="POST">
                  <button class="btn btn-danger btn-sm" type="submit">삭제</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <p class="text-center text-muted">등록된 반려동물이 없습니다. 아래 폼을 통해 등록해주세요.</p>
    <% } %>
  </div>

  <!-- 반려동물 등록/수정 입력창 -->
  <div class="container mt-4" id="pet-form" style="<% if (pets && pets.length > 0) { %>display: none;<% } %>">
    <form action="<% if (pets && pets.length > 0) { %>/mypet/<%= pets[0]._id %>?_method=PUT<% } else { %>/mypet<% } %>" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label for="photo" class="form-label">사진 업로드</label>
        <input type="file" name="photo" class="form-control" accept="image/*" onchange="loadFile(event)">
        <div class="addImg">
          <img id="output" width="200" height="150" style="object-fit: cover; display: none;">
        </div>
      </div>

      <input type="text" name="name" placeholder="이름" value="<%= pets && pets.length > 0 ? pets[0].name : '' %>" required>
      <select name="gender" required>
        <option value="Male" <% if (pets && pets.length > 0 && pets[0].gender === 'Male') { %>selected<% } %>>남자</option>
        <option value="Female" <% if (pets && pets.length > 0 && pets[0].gender === 'Female') { %>selected<% } %>>여자</option>
      </select>
      <input type="number" name="weight" placeholder="몸무게 (kg)" value="<%= pets && pets.length > 0 ? pets[0].weight[0]?.value : '' %>" required>
      <input type="text" name="diseases" placeholder="질환" value="<%= pets && pets.length > 0 ? pets[0].diseases : '' %>">
      <input type="number" name="age" placeholder="나이 (세)" value="<%= pets && pets.length > 0 ? pets[0].age : '' %>" required>
      <button type="submit" class="btn btn-success"><% if (pets && pets.length > 0) { %>저장하기<% } else { %>등록하기<% } %></button>
      <% if (pets && pets.length > 0) { %>
        <button type="button" class="btn btn-secondary" onclick="cancelEdit()">취소</button>
      <% } %>
    </form>
  </div>

  <script>
    function loadFile(event) {
      const output = document.getElementById('output');
      output.src = URL.createObjectURL(event.target.files[0]);
      output.style.display = 'block';
    }

    function editPet() {
      document.getElementById('pet-info').style.display = 'none';
      document.getElementById('pet-form').style.display = 'block';
    }

    function cancelEdit() {
      document.getElementById('pet-info').style.display = 'block';
      document.getElementById('pet-form').style.display = 'none';
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
