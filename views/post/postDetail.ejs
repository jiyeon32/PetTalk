<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/postDetail.css">
    <link rel="stylesheet" href="css/common.css">
</head>

<body>

<!-- 공통 헤더 포함 -->
<%- include('../header') %>
    
<!-- 게시글 내용 -->
<div class="container">
    <section class="content-section">
        <h2>
            <% if (post.tag) { %>
                [<%= post.tag %>]
            <% } %>
            <%= post.title %>
        </h2>
        <p class="post-meta">작성자: <%= post.author.nickname %> | 작성일: <%= post.createdAt.toLocaleString() %></p>
        <hr>
        <% if (post.image) { %>
            <!-- 이미지 표시 -->
            <div class="mb-3">
                <img src="<%= post.image %>" alt="첨부된 이미지" class="img-fluid rounded">
            </div>
        <% } %>
        <p><%= post.content %></p>
        <hr>
        <% if (userId && post.author._id.toString() === userId.toString()) { %>
            <button class="small-button" onclick="window.location.href='/posts/<%= post._id %>/edit';">수정</button>
            <form action="/posts/<%= post._id %>?_method=DELETE" method="POST" style="display:inline;">
                <button type="submit" class="small-button">삭제</button>
            </form>
        <% } %>
    </section>

        <section class="comment-section">
            <h2>댓글</h2>
            <hr>
            <ul>
                <% post.comments.forEach(function(comment) { %>
                    <li class="comment-item" id="comment-<%= comment._id %>">
                        <!-- 댓글 날짜와 내용 -->
                        <p class="comment-date"><%= comment.createdAt.toLocaleString() %></p>
                        <p class="comment-content" id="content-<%= comment._id %>"><%= comment.content %></p>
        
                        <% if (userId && comment.author._id.toString() === userId.toString()) { %>
                            <!-- 수정 버튼 -->
                            <button class="small-button edit-btn" onclick="showEditForm('<%= comment._id %>')">수정</button>
        
                            <!-- 삭제 버튼 -->
                            <form action="/comments/<%= comment._id %>?_method=DELETE" method="POST" style="display: inline;" class="delete-btn">
                                <button class="small-button">삭제</button>
                            </form>
        
                            <!-- 숨겨진 수정 폼 -->
                            <form id="edit-form-<%= comment._id %>" action="/comments/<%= comment._id %>?_method=PUT" method="POST" style="display: none;">
                                <textarea name="content" rows="2"><%= comment.content %></textarea>
                                <button class="small-button" type="submit">저장</button>
                            </form>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        
            <% if (userId) { %>
                <form action="/posts/<%= post._id %>/comments" method="POST">
                    <textarea name="content" rows="4" placeholder="댓글을 입력하세요"></textarea>
                    <button type="submit" class="small-button">댓글 달기</button>
                </form>
            <% } else { %>
                <p>댓글을 달려면 <a href="/login">로그인</a>하세요.</p>
            <% } %>
        </section>
        
    </div>

    <script>
        function showEditForm(commentId) {
            // 기존 댓글 내용 숨기기
            const contentElement = document.getElementById(`content-${commentId}`);
            contentElement.style.display = 'none';
    
            // 수정 폼 보이기
            const editForm = document.getElementById(`edit-form-${commentId}`);
            editForm.style.display = 'block';
    
            // 수정 버튼과 삭제 버튼 숨기기
            const commentItem = document.getElementById(`comment-${commentId}`);
            const editBtn = commentItem.querySelector('.edit-btn');
            const deleteBtn = commentItem.querySelector('.delete-btn');
    
            if (editBtn) editBtn.style.display = 'none';
            if (deleteBtn) deleteBtn.style.display = 'none';
        }
    </script>
    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossorigin="anonymous"></script>
</body>
</html>
