<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= group.name %> 상세 정보</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="css/group.css">
</head>

<body>
  <!-- 공통 헤더 -->
  <%- include('../header') %>

  <div class="container my-4">
    <h2 class="text-center"><%= group.name %></h2>
    <p class="text-muted text-center">지역: <%= group.region %></p>

    <!-- 그룹 소개 -->
    <div class="my-4">
      <h4>그룹 소개</h4>
      <p><%= group.description %></p>
    </div>

    <!-- 참가자 리스트 -->
    <div class="my-4">
      <h4>참가자 리스트</h4>
      <ul class="list-group">
        <% if (group.members.length > 0) { %>
          <% group.members.forEach(member => { %>
            <li class="list-group-item">
              <%= member.userId.nickname || '알 수 없는 사용자' %>
            </li>
          <% }); %>
        <% } else { %>
          <li class="list-group-item text-muted">참가자가 없습니다.</li>
        <% } %>
      </ul>
    </div>

    <!-- 모임 일정 -->
    <div class="my-4">
      <h4>모임 일정</h4>
      <p class="text-muted">모임 일정은 추후 업데이트 예정입니다.</p>
    </div>

    <!-- 가입 신청 버튼 -->
    <% if (userId && group.members) { %>
      <% if (!group.members.some(member => String(member.userId._id) === String(userId))) { %>
        <div class="text-center">
          <form action="/group/<%= group._id %>/join" method="POST">
            <button type="submit" class="btn btn-primary">그룹 가입 신청</button>
          </form>
        </div>
      <% } else { %>
        <!-- 그룹 탈퇴 버튼 (가입되어 있는 경우) -->
        <div class="text-center mt-4">
          <form id="leave-form" method="POST" action="/group/<%= group._id %>/leave">
            <button type="button" class="btn btn-danger" id="leave-btn">그룹 탈퇴</button>
          </form>
        </div>
      <% } %>
    <% } %>

    <!-- 관리자 전용 수정 섹션 -->
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <hr>
      <!-- 수정 버튼 -->
      <div class="text-center">
        <button id="edit-btn" class="btn btn-warning">그룹 정보 수정</button>
      </div>
    
      <!-- 수정 폼 -->
      <div id="edit-form" style="display: none;" class="my-4">
        <h4>그룹 정보 수정</h4>
        <form action="/group/<%= group._id %>/edit" method="POST">
          <div class="mb-3">
            <label for="name" class="form-label">그룹 이름</label>
            <input type="text" class="form-control" id="name" name="name" value="<%= group.name %>" required>
          </div>
          <div class="mb-3">
            <label for="region" class="form-label">지역</label>
            <input type="text" class="form-control" id="region" name="region" value="<%= group.region %>" required>
          </div>
          <div class="mb-3">
            <label for="description" class="form-label">그룹 설명</label>
            <textarea class="form-control" id="description" name="description" rows="5" required><%= group.description %></textarea>
          </div>
          <button type="submit" class="btn btn-success">수정 완료</button>
        </form>
      </div>
    <% } %>
    

  <script>
    // 수정 버튼 클릭 시 수정 폼 토글
    document.getElementById('edit-btn')?.addEventListener('click', function() {
      const editForm = document.getElementById('edit-form');
      if (editForm.style.display === 'none' || editForm.style.display === '') {
        editForm.style.display = 'block';
      } else {
        editForm.style.display = 'none';
      }
    });

    // 탈퇴 버튼 클릭 처리
    document.getElementById('leave-btn')?.addEventListener('click', async function(event) {
      event.preventDefault(); // 폼 제출을 막습니다.
  
      if (confirm('정말로 이 그룹을 탈퇴하시겠습니까?')) {
        try {
          const response = await fetch(`/group/<%= group._id %>/leave`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ userId: '<%= userId %>' }),  // 세션에서 userId를 body로 전달
          });
  
          const data = await response.json();
  
          if (response.ok) {
            alert('그룹에서 탈퇴되었습니다.');
            window.location.href = `/group/<%= group._id %>`; // 탈퇴 후 해당 그룹 페이지로 리다이렉트
          } else {
            alert(data.message || '탈퇴에 실패했습니다.');
          }
        } catch (error) {
          console.error('탈퇴 처리 중 오류 발생:', error);
          alert('탈퇴 처리 중 오류가 발생했습니다.');
        }
      }
    });
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>
