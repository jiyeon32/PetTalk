<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>반려동물 커뮤니티</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Source+Sans+Pro&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/index.css">
  <link rel="stylesheet" href="css/common.css">
</head>

<body>

 <!-- 공통 헤더 포함 -->
<%- include('header') %>

  <!-- 게시판 섹션 -->
  <section class="container my-5">
    <h2 class="text-center mb-4">카테고리별 인기 게시글</h2>
    <div class="row">
      <% Object.entries(popularPosts).forEach(([category, posts]) => { %>
        <div class="col-md-6 mb-4">
          <div class="card shadow-sm">
            <div class="card-body">
              <h5 class="card-title text-primary"><%= category %> - 인기 게시글</h5>
              <ul class="list-group list-group-flush">
                <% if (posts.length > 0) { %>
                  <% posts.forEach(post => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                      <a href="/posts/<%= post._id %>" class="text-decoration-none"><%= post.title %></a>
                      <span class="badge bg-secondary">댓글 수: <%= post.comments.length %></span>
                    </li>
                  <% }); %>
                <% } else { %>
                  <li class="list-group-item text-muted">게시글이 없습니다.</li>
                <% } %>
              </ul>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>